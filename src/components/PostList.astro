---
import { url } from "@/lib/site";
import { formatDate } from "@/lib/entries";
import { CATEGORY_LABEL, type Post } from "@/lib/posts";
interface Props {
  posts: Post[];
}
const { posts } = Astro.props;
---

<ul class="post-list">
  {posts.map((p) => (
    <li data-category={p.data.category}>
      <a href={url(`/${p.collection}/${p.id}`)} class="row">
        <span class="mono date">{formatDate(p.data.date)}</span>
        <span class="main">
          <span class="title">{p.data.title}</span>
          <span class="summary">{p.data.summary}</span>
        </span>
        <span class="mono category">{CATEGORY_LABEL[p.data.category]}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  ul { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line-strong); }
  li { border-bottom: 1px solid var(--line); }
  .row {
    display: grid;
    grid-template-columns: 88px minmax(0, 1fr) 80px;
    gap: var(--s-5);
    align-items: baseline;
    padding: var(--s-4) 0;
  }
  a.row:hover { background: var(--surface); }
  .date, .category { color: var(--muted); }
  .category { text-align: right; }
  .main { display: flex; flex-direction: column; gap: 2px; }
  .title { font-size: var(--t-md); font-weight: 600; color: var(--ink); }
  .summary { font-size: var(--t-sm); color: var(--muted); }

  @media (max-width: 720px) {
    .row {
      grid-template-columns: 1fr auto;
      grid-template-areas: "main main" "date category";
      gap: var(--s-1) var(--s-3);
    }
    .main { grid-area: main; }
    .date { grid-area: date; }
    .category { grid-area: category; }
  }
</style>
