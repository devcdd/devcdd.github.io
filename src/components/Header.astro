---
import { SECTIONS, SITE, url } from "@/lib/site";
const path = Astro.url.pathname;
// 메뉴마다 밑줄 막대 색. 섹션이 아닌 메뉴(태그, 소개)는 본문 글자색
const markOf = (href: string) => Object.values(SECTIONS).find((s) => s.href === href)?.mark ?? "var(--ink)";
const isActive = (href: string) => path === url(href) || path.startsWith(url(href) + "/");
---

<header class="site-header">
  <div class="container bar">
    <a href={url("/")} class="wordmark" aria-label={SITE.name} data-flicker>
      {[...SITE.name].map((ch) => <span class="ch" aria-hidden="true">{ch}</span>)}
    </a>
    <div class="end">
      <nav data-nav>
        {SITE.nav.map((item) => (
          <a href={url(item.href)} aria-current={isActive(item.href) ? "page" : undefined} data-mark={markOf(item.href)}>{item.label}</a>
        ))}
        <span class="indicator" aria-hidden="true" data-indicator></span>
      </nav>
      <button type="button" class="theme-toggle" aria-label="다크 모드로 전환" data-theme-toggle>
        <svg class="icon-moon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
        </svg>
        <svg class="icon-sun" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.6" />
          <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  const systemDark = matchMedia("(prefers-color-scheme: dark)");
  const isDark = () => {
    const theme = document.documentElement.dataset.theme;
    return theme ? theme === "dark" : systemDark.matches;
  };
  const sync = () => button?.setAttribute("aria-label", isDark() ? "라이트 모드로 전환" : "다크 모드로 전환");

  button?.addEventListener("click", () => {
    const next = isDark() ? "light" : "dark";
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem("labs:theme", next);
    } catch {}
    sync();
  });
  systemDark.addEventListener("change", sync);
  sync();

  // 로고에 마우스를 올리면 글자마다 무작위로 깜빡이고 흔들리며 빨강·청록 잔상이 생기는 글리치. 글자 자체는 바꾸지 않음
  const logo = document.querySelector<HTMLElement>("[data-flicker]");
  if (logo && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const chars = [...logo.querySelectorAll<HTMLElement>(".ch")];
    const GLITCH_MS = 1000;
    const FRAME_MS = 120;
    let running = false;
    const reset = (c: HTMLElement) => {
      c.style.opacity = "";
      c.style.transform = "";
      c.style.textShadow = "";
    };
    const glitch = () => {
      if (running) return;
      running = true;
      const start = performance.now();
      const frame = () => {
        if (performance.now() - start >= GLITCH_MS) {
          chars.forEach(reset);
          running = false;
          return;
        }
        chars.forEach((c) => {
          const r = Math.random();
          c.style.opacity = r < 0.2 ? "0" : r < 0.35 ? "0.45" : "1";
          const hit = Math.random() < 0.4;
          const dx = hit ? Math.round((Math.random() * 2 - 1) * 3) : 0;
          c.style.transform = dx ? `translateX(${dx}px)` : "";
          c.style.textShadow = hit ? "-2px 0 rgba(255, 0, 80, 0.75), 2px 0 rgba(0, 220, 255, 0.75)" : "";
        });
        setTimeout(() => requestAnimationFrame(frame), FRAME_MS);
      };
      frame();
    };
    logo.addEventListener("mouseenter", glitch);
    logo.addEventListener("focus", glitch);
  }

  // 메뉴 밑줄: 막대 하나. 메뉴를 누르면 지금 페이지에서 막대가 그 메뉴로 미끄러지며 색이 바뀐 뒤 이동하고,
  // 새 페이지는 막대를 이미 현재 메뉴 자리·색으로 그려 시작하므로 움직임이 끊기지 않음
  const nav = document.querySelector<HTMLElement>("[data-nav]");
  const bar = document.querySelector<HTMLElement>("[data-indicator]");
  if (nav && bar) {
    const MOVE_MS = 320;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const links = [...nav.querySelectorAll<HTMLAnchorElement>("a")];
    const current = links.find((a) => a.getAttribute("aria-current") === "page") ?? null;
    const to = (a: HTMLAnchorElement | null) => {
      if (!a) {
        bar.style.width = "0px";
        return;
      }
      bar.style.transform = `translateX(${a.offsetLeft}px)`;
      bar.style.width = `${a.offsetWidth}px`;
      bar.style.background = a.dataset.mark ?? "";
    };

    to(current);
    requestAnimationFrame(() => requestAnimationFrame(() => bar.classList.add("ready")));
    addEventListener("resize", () => to(current));

    for (const a of links) {
      a.addEventListener("click", (e) => {
        // 새 탭·새 창으로 여는 클릭과 현재 메뉴는 기본 동작 그대로
        if (reduce || a === current || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
        e.preventDefault();
        // 홈처럼 막대가 없던 곳에서는 누른 메뉴 가운데에서 펼쳐지게 시작 위치를 잡음
        if (!current) {
          bar.classList.remove("ready");
          bar.style.transform = `translateX(${a.offsetLeft + a.offsetWidth / 2}px)`;
          bar.style.width = "0px";
          bar.style.background = a.dataset.mark ?? "";
          void bar.offsetWidth;
          bar.classList.add("ready");
        }
        to(a);
        setTimeout(() => (location.href = a.href), MOVE_MS);
      });
    }
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .wordmark .ch { display: inline-block; text-align: center; }
  .wordmark {
    font-family: var(--font-display);
    font-size: var(--t-lg);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }
  .end { display: flex; align-items: center; gap: var(--s-5); min-width: 0; }
  nav { display: flex; gap: var(--s-5); }
  .theme-toggle {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .theme-toggle:hover { color: var(--ink); border-color: var(--ink); }
  /* 지금 테마의 반대쪽 아이콘을 보여 준다 */
  .icon-sun { display: none; }
  :global(:root[data-theme="dark"]) .icon-moon { display: none; }
  :global(:root[data-theme="dark"]) .icon-sun { display: block; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .icon-moon { display: none; }
    :global(:root:not([data-theme="light"])) .icon-sun { display: block; }
  }
  /* 메뉴가 화면 폭을 넘으면 줄바꿈 대신 가로로 밀어 본다 */
  @media (max-width: 720px) {
    .bar { gap: var(--s-4); }
    .wordmark { flex-shrink: 0; }
    .end { gap: var(--s-3); }
    nav { gap: var(--s-4); min-width: 0; overflow-x: auto; scrollbar-width: none; white-space: nowrap; }
  }
  nav a {
    font-size: var(--t-sm);
    color: var(--muted);
  }
  nav a:hover,
  nav a[aria-current="page"] { color: var(--ink); }
  /* 현재 섹션 메뉴 밑의 섹션 색 막대. 위치·폭은 스크립트가 정함 */
  nav { position: relative; }
  nav a { padding-block: 4px; }
  .indicator {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0;
    height: 2px;
    pointer-events: none;
  }
  .indicator.ready {
    transition:
      transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1),
      width 0.3s cubic-bezier(0.2, 0.8, 0.2, 1),
      background-color 0.3s ease;
  }
  @media (prefers-reduced-motion: reduce) {
    .indicator.ready { transition: none; }
  }
</style>
