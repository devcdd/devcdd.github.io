---
import { url } from "@/lib/site";
import { sessionSlug, type Conference, type Session } from "@/lib/conferences";
interface Props {
  conference: Conference;
  sessions: Session[];
}
const { conference, sessions } = Astro.props;
const timetable = conference.data.timetable;

const tracks = [...new Set(timetable.flatMap((t) => (t.track ? [t.track] : [])))].sort();
const times = [...new Set(timetable.map((t) => t.time))].sort();
const slots = times.map((time) => {
  const items = timetable.filter((t) => t.time === time);
  return { time, items, spanning: items.find((t) => !t.track) };
});
const picked = (time: string, track?: string) =>
  sessions.find((s) => s.data.time === time && s.data.track === track);
const href = (s: Session) => url(`/conferences/${conference.id}/${sessionSlug(s)}`);
---

{timetable.length > 0 && (
  <section class="timetable folded" aria-labelledby="timetable-title">
    <div class="caption">
      <h2 id="timetable-title" class="label">
        <button type="button" class="fold" aria-expanded="false" aria-controls="timetable-body">
          시간표 <span class="chevron" aria-hidden="true"></span>
        </button>
      </h2>
      <button type="button" class="only-toggle label" aria-pressed="false">
        <span class="switch" aria-hidden="true"></span>
        들은 세션만
      </button>
    </div>
    <div id="timetable-body" class="scroll" hidden>
      <table>
        <thead>
          <tr>
            <th scope="col" class="time"><span class="visually-hidden">시간</span></th>
            {tracks.map((t) => <th scope="col">{t}</th>)}
          </tr>
        </thead>
        <tbody>
          {slots.map(({ time, items, spanning }) => (
            <tr>
              <th scope="row" class="mono time">
                <span class="start">{time.split("-")[0]}</span>
                <span class="end"><span class="visually-hidden">–</span>{time.split("-")[1]}</span>
              </th>
              {spanning ? (
                <td colspan={tracks.length} class="cell spanning">
                  <span class="title">{spanning.title}</span>
                  <span class="speakers">{spanning.speakers.join(", ")}</span>
                </td>
              ) : (
                tracks.map((track) => {
                  const item = items.find((t) => t.track === track);
                  const mine = picked(time, track);
                  if (!item) return <td class="cell" />;
                  return mine ? (
                    <td class="cell mine">
                      <a href={href(mine)}>
                        <span class="track">{track}</span>
                        <span class="title">{item.title}</span>
                        <span class="speakers">{item.speakers.join(", ")}</span>
                      </a>
                    </td>
                  ) : (
                    <td class="cell">
                      <span class="title" title={item.title}>{item.title}</span>
                    </td>
                  );
                })
              )}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
)}

<style>
  /* 강조색은 현재 섹션 색(기웃기웃 민트), 섹션 밖에서는 사이트 강조색 */
  .timetable { --tt-accent: var(--section-color, var(--accent)); padding-bottom: var(--s-6); }
  .caption {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: var(--s-2);
    border-bottom: 1px solid var(--line-strong);
  }
  /* "시간표"와 "들은 세션만"을 같은 글꼴·크기로 */
  .caption h2 { margin: 0; font: inherit; }
  button {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    padding: var(--s-1) 0;
    border: 0;
    background: none;
    font-family: var(--font-sans);
    font-size: var(--t-sm);
    font-weight: 600;
    letter-spacing: 0;
    color: var(--muted);
    cursor: pointer;
  }
  .fold { color: var(--ink); }
  button:hover, .only-toggle[aria-pressed="true"] { color: var(--ink); }
  button:focus-visible { outline: 2px solid var(--accent-text); outline-offset: 2px; }

  .chevron {
    width: 6px;
    height: 6px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-2px) rotate(45deg);
    transition: transform 0.15s;
  }
  [aria-expanded="false"] .chevron { transform: rotate(-45deg); }

  .switch {
    position: relative;
    width: 26px;
    height: 14px;
    border-radius: 7px;
    background: var(--line);
    transition: background 0.15s;
  }
  .switch::after {
    content: "";
    position: absolute;
    top: 2px;
    left: 2px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--bg);
    transition: transform 0.15s;
  }
  [aria-pressed="true"] .switch { background: var(--ink); }
  [aria-pressed="true"] .switch::after { transform: translateX(12px); }

  .timetable.folded .only-toggle { visibility: hidden; }
  .timetable.folded .caption { border-bottom-color: var(--line); }

  /* ── 전체 보기: 시간대마다 가로선, 들은 세션은 섹션 색 면 ── */
  /* 트랙이 7개라 좁은 화면에서는 표 전체를 가로로 밀어 봄 */
  .scroll { overflow-x: auto; }
  table {
    width: 100%;
    min-width: 880px;
    border-collapse: collapse;
    table-layout: fixed;
    word-break: keep-all;
  }
  thead th {
    padding: var(--s-3) var(--s-2) var(--s-2);
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    font-weight: 500;
    color: var(--ink-2);
    text-align: left;
    border-bottom: 1px solid var(--line);
  }
  tbody tr { border-bottom: 1px solid var(--line); }
  th.time { width: 64px; padding-left: 0; vertical-align: top; position: sticky; left: 0; z-index: 1; background: var(--bg); }
  tbody th.time { padding: var(--s-3) var(--s-2) var(--s-3) 0; font-family: var(--font-mono); font-weight: 500; text-align: left; line-height: 1.4; }
  .time .start, .time .end { display: block; }
  .time .start { font-size: var(--t-sm); color: var(--ink); }
  .time .end { font-size: var(--t-xs); color: var(--faint); }

  .cell {
    vertical-align: top;
    padding: var(--s-3) var(--s-2);
    font-size: 13px;
    line-height: 1.45;
  }
  .cell .title {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
    color: var(--muted);
  }
  .speakers { display: block; margin-top: 4px; font-size: var(--t-xs); color: var(--muted); }

  .spanning { background: var(--surface); }
  .spanning .title, .spanning .speakers { display: inline; margin: 0; }
  .spanning .title { color: var(--ink); font-weight: 600; margin-right: var(--s-2); }

  .mine {
    background: color-mix(in srgb, var(--tt-accent) 22%, var(--bg));
    box-shadow: inset 3px 0 0 var(--tt-accent);
  }
  .mine a { display: block; color: inherit; }
  .mine .title { color: var(--ink); font-weight: 600; }
  .mine .speakers { color: var(--ink-2); }
  .mine a:hover .title { text-decoration: underline; text-underline-offset: 3px; }
  .track { display: none; }

  /* ── 들은 세션만: 상자 대신 일정표. 왼쪽 시간, 오른쪽 트랙·제목·연사 ── */
  .timetable.only table, .timetable.only tbody { display: block; min-width: 0; }
  .timetable.only thead { display: none; }
  .timetable.only tr {
    display: grid;
    grid-template-columns: 88px minmax(0, 1fr);
    gap: var(--s-4);
    padding: var(--s-4) 0;
  }
  .timetable.only tr:not(:has(.mine)), .timetable.only .cell:not(.mine) { display: none; }
  .timetable.only th.time { position: static; width: auto; padding: 2px 0 0; }
  .timetable.only .time .start { font-size: var(--t-md); }
  .timetable.only .mine { padding: 0; background: none; box-shadow: none; font-size: var(--t-sm); }
  .timetable.only .track {
    display: inline-flex;
    align-items: center;
    height: 21px;
    margin-bottom: 6px;
    padding: 0 6px;
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    line-height: 1;
    background: color-mix(in srgb, var(--tt-accent) 28%, var(--bg));
    color: var(--ink-2);
    will-change: transform;
  }
  .timetable.only .mine .title { display: block; font-size: var(--t-md); line-height: 1.5; -webkit-line-clamp: unset; }
  .timetable.only .speakers { margin-top: 2px; font-size: var(--t-sm); color: var(--muted); }

  @media (max-width: 720px) {
    .timetable.only tr { grid-template-columns: 64px minmax(0, 1fr); gap: var(--s-3); }
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>

<script>
  const read = (key: string, fallback: boolean) => {
    try {
      const v = localStorage.getItem(key);
      return v === null ? fallback : v === "1";
    } catch {
      return fallback;
    }
  };
  const write = (key: string, on: boolean) => {
    try {
      localStorage.setItem(key, on ? "1" : "0");
    } catch {}
  };

  for (const section of document.querySelectorAll<HTMLElement>(".timetable")) {
    const fold = section.querySelector<HTMLButtonElement>(".fold");
    const only = section.querySelector<HTMLButtonElement>(".only-toggle");
    const body = section.querySelector<HTMLElement>(".scroll");
    if (!fold || !only || !body) continue;

    const setOpen = (open: boolean) => {
      body.hidden = !open;
      section.classList.toggle("folded", !open);
      fold.setAttribute("aria-expanded", String(open));
    };
    const setOnly = (on: boolean) => {
      section.classList.toggle("only", on);
      only.setAttribute("aria-pressed", String(on));
    };
    setOpen(read("labs:timetable-open", false));
    setOnly(read("labs:timetable-only", false));

    fold.addEventListener("click", () => {
      const open = fold.getAttribute("aria-expanded") !== "true";
      setOpen(open);
      write("labs:timetable-open", open);
    });
    only.addEventListener("click", () => {
      const on = only.getAttribute("aria-pressed") !== "true";
      setOnly(on);
      write("labs:timetable-only", on);
    });
  }
</script>
