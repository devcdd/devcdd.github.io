---
import Base from "@/layouts/Base.astro";
import PostList from "@/components/PostList.astro";
import SectionHead from "@/components/SectionHead.astro";
import { SECTIONS } from "@/lib/site";
import { getPosts, type PostCollection } from "@/lib/posts";

export function getStaticPaths() {
  return (["posts", "notes"] as const).map((collection) => ({ params: { collection } }));
}

const collection = Astro.params.collection as PostCollection;
const section = SECTIONS[collection];
const posts = await getPosts(collection);
---

<Base title={section.label} description={section.caption} section={collection}>
  <div class="container">
    <SectionHead section={collection}>
      {import.meta.env.DEV && collection === "posts" && <a href="/__editor">편집기</a>} {posts.length}
    </SectionHead>
    <PostList posts={posts} />
  </div>
</Base>
