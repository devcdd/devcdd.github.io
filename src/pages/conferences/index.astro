---
import Base from "@/layouts/Base.astro";
import ConferenceList from "@/components/ConferenceList.astro";
import SectionHead from "@/components/SectionHead.astro";
import { SECTIONS } from "@/lib/site";
import { getConferences, getSessionsByConference } from "@/lib/conferences";

const section = SECTIONS.conferences;
const conferences = await getConferences();
const sessions = await getSessionsByConference();
const counts = new Map([...sessions].map(([id, list]) => [id, list.length]));
---

<Base title={section.label} description={section.caption} section="conferences">
  <div class="container">
    <SectionHead section="conferences">{conferences.length}</SectionHead>
    <ConferenceList conferences={conferences} sessionCounts={counts} />
  </div>
</Base>
