---
import Base from "@/layouts/Base.astro";
import { SECTIONS, SITE, sectionStyle, url, type SectionKey } from "@/lib/site";
import { getEntries } from "@/lib/entries";
import { getPosts } from "@/lib/posts";
import { getConferences } from "@/lib/conferences";

const [entries, posts, notes, conferences] = await Promise.all([
  getEntries(),
  getPosts(),
  getPosts("notes"),
  getConferences(),
]);
// 글자마다 순번(--i)을 매겨 차례로 등장시킴
const wordmark = ["CDD", "LABS"].map((line, li, all) => {
  const offset = all.slice(0, li).join("").length;
  return [...line].map((ch, i) => ({ ch, i: offset + i }));
});
const doors = [
  { key: "entries", count: entries.length },
  { key: "notes", count: notes.length },
  { key: "posts", count: posts.length },
  { key: "conferences", count: conferences.length },
].map((d) => ({ ...d, ...SECTIONS[d.key as SectionKey] }));
---

<Base>
  <section class="container intro">
    <div class="lead">
      <p class="tagline">{SITE.tagline}</p>
      <h1 class="wordmark" aria-label="CDD LABS">
        {wordmark.map((line, li) => (
          <span class="line" aria-hidden="true">
            {line.map(({ ch, i }) => <span class="ch" style={`--i:${i}`}>{ch}</span>)}
            {li === wordmark.length - 1 && <span class="caret"></span>}
          </span>
        ))}
      </h1>
    </div>
    <div class="term" aria-label="사이트 소개">
      <div class="titlebar" aria-hidden="true">
        <span class="lights"><i></i><i></i><i></i></span>
        <span class="title">cdd — labs</span>
      </div>
      <p class="prompt"><span class="sign" aria-hidden="true">❯</span><span class="ask">여기 뭐하는 곳인지 설명 좀 해줘.</span></p>
      <div class="reply">
        <span class="lead" aria-hidden="true" data-lead>●</span>
        <p class="answer" data-typing>
          제 머릿속에 있는 <em class="hl">여러 가지 아이디어</em>들을<br />
          기획하고, 스케치하는 <em class="hl">스케치북</em> 같은 공간입니다.<br />
          요즘 같은 시대에 <em class="hl">쇠맛</em> 안 나게 잘 가꿔보겠습니다.
        </p>
      </div>
      <p class="done" aria-hidden="true" data-done></p>
      <!-- 첫 대화와 번갈아 재생되는 두 번째 대화. 스크립트가 질문을 지우고 이 내용으로 바꿔 씀 -->
      <template data-next-round data-ask="주인장은 뭐하는 놈이야?">
        <em class="hl">새롭고 재밌는 것</em>을 좋아하고,<br />
        인생을 <em class="hl">다채롭게</em> 사는 것을 좋아하며,<br />
        <em class="hl">생각하는 것</em>을 좋아하는 사람으로 알고 있습니다.
      </template>
    </div>
  </section>

  <nav class="container doors" aria-label="진입점">
    {doors.map((d) => (
      <a href={url(d.href)} class:list={["door", { outlined: d.outlined }]} style={sectionStyle(d.key as SectionKey)}>
        <span class="door-label" data-motion={d.key}>
          <span class="visually-hidden">{d.label}</span>
          {[...d.label].map((ch, i) => <span class="lch" aria-hidden="true" style={`--i:${i}`}>{ch}</span>)}
        </span>
        <span class="door-caption">{d.caption}</span>
        <span class="door-foot">
          <span class="n">글 {d.count}개 있음</span>
          <span class="arrow" aria-hidden="true">→</span>
        </span>
      </a>
    ))}
  </nav>
</Base>

<script>
  // 소개를 Claude Code 대화처럼 재생: 질문 입력 → 생각 중 → 답변 출력 → 마무리 줄.
  // 대화가 끝나고 10초 뒤 질문을 지우고 다음 대화(<template data-next-round>)를 재생하며, 두 대화를 번갈아 무한 반복.
  // 문장은 HTML에 그대로 두고 화면에서만 지웠다가 다시 찍음
  const ask = document.querySelector<HTMLElement>(".ask");
  const answer = document.querySelector<HTMLElement>("[data-typing]");
  const lead = document.querySelector<HTMLElement>("[data-lead]");
  const done = document.querySelector<HTMLElement>("[data-done]");
  const next = document.querySelector<HTMLTemplateElement>("[data-next-round]");
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

  type Piece = { ch: string; hl: boolean };
  const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
  const jitter = (min: number, range: number) => min + Math.random() * range;
  const pick = <T,>(list: readonly T[]) => list[Math.floor(Math.random() * list.length)];
  const sample = <T,>(list: readonly T[], n: number) => {
    const pool = [...list];
    for (let i = pool.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [pool[i], pool[j]] = [pool[j], pool[i]];
    }
    return pool.slice(0, n);
  };

  // 강조(em.hl) 구간을 유지하도록 글자를 [문자, 강조 여부]로 펼침. "\n"은 줄바꿈, HTML 들여쓰기 공백은 제거
  const toPieces = (root: ParentNode): Piece[] => {
    const pieces: Piece[] = [];
    for (const node of root.childNodes) {
      if (node instanceof HTMLBRElement) pieces.push({ ch: "\n", hl: false });
      else if (node instanceof HTMLElement && node.classList.contains("hl"))
        for (const ch of node.textContent!) pieces.push({ ch, hl: true });
      else if (node.nodeType === Node.TEXT_NODE)
        for (const ch of node.textContent!.replace(/\s+/g, " ")) pieces.push({ ch, hl: false });
    }
    return pieces.filter((p, i, all) => {
      if (p.ch !== " ") return true;
      const prev = all[i - 1]?.ch;
      const nextCh = all[i + 1]?.ch;
      return prev !== undefined && nextCh !== undefined && prev !== "\n" && nextCh !== "\n";
    });
  };
  const plain = (pieces: Piece[]) => pieces.map((p) => (p.ch === "\n" ? " " : p.ch)).join("");

  const makeCursor = () => {
    const c = document.createElement("span");
    c.className = "cursor";
    c.setAttribute("aria-hidden", "true");
    return c;
  };

  const typeAsk = async (text: string) => {
    ask!.setAttribute("aria-label", text);
    const typed = document.createElement("span");
    typed.setAttribute("aria-hidden", "true");
    const cursor = makeCursor();
    ask!.replaceChildren(typed, cursor);
    for (const ch of text) {
      typed.append(ch);
      await wait(jitter(45, 45));
    }
    await wait(350);
    cursor.remove();
  };

  const eraseAsk = async () => {
    const typed = ask!.querySelector<HTMLElement>("span[aria-hidden]");
    const cursor = makeCursor();
    ask!.append(cursor);
    while (typed && typed.textContent) {
      typed.textContent = typed.textContent.slice(0, -1);
      await wait(jitter(18, 14));
    }
    await wait(300);
    cursor.remove();
  };

  // 생각 중: 왼쪽 열 기호가 돌고 초·토큰 수가 올라감
  const GLYPHS = ["·", "✢", "✳", "✶", "✻", "✽", "✻", "✶", "✳", "✢"];
  const VERBS = [
    "Moseying", "Pondering", "Sketching", "Brewing", "Noodling", "Tinkering", "Mulling", "Percolating",
    "Simmering", "Doodling", "Musing", "Conjuring", "Whittling", "Puttering", "Ruminating", "Marinating",
    "Scribbling", "Cogitating", "Fiddling", "Wrangling", "Hatching", "Spelunking", "Finagling", "Kneading",
    "Untangling", "Combobulating", "Daydreaming", "Rummaging",
  ];
  const DONE_VERBS = [
    "Baked", "Brewed", "Cooked", "Crunched", "Churned", "Simmered", "Sautéed", "Stewed", "Toasted",
    "Whisked", "Kneaded", "Noodled", "Tinkered", "Mulled", "Cogitated", "Pondered", "Whittled", "Conjured",
  ];
  const THINK_MS = 1800;
  const think = async (started: number) => {
    const verbs = sample(VERBS, 3 + Math.floor(Math.random() * 2));
    const status = document.createElement("span");
    status.className = "status";
    status.setAttribute("aria-hidden", "true");
    answer!.replaceChildren(status);
    lead!.classList.add("spinning");
    let frame = 0;
    let tokens = 0;
    const render = () => {
      const elapsed = performance.now() - started;
      tokens += Math.floor(jitter(40, 80));
      const verb = verbs[Math.min(verbs.length - 1, Math.floor(elapsed / (THINK_MS / verbs.length)))];
      lead!.textContent = GLYPHS[frame++ % GLYPHS.length];
      status.innerHTML = `${verb}… <span class="meta">(${Math.floor(elapsed / 1000)}s · ↓ ${(tokens / 1000).toFixed(1)}k tokens · thinking)</span>`;
    };
    render();
    const timer = setInterval(render, 120);
    await wait(THINK_MS);
    clearInterval(timer);
    lead!.classList.remove("spinning");
  };

  const typeAnswer = async (pieces: Piece[]) => {
    answer!.setAttribute("aria-label", plain(pieces));
    const out = document.createElement("span");
    out.setAttribute("aria-hidden", "true");
    answer!.replaceChildren(out);
    lead!.textContent = "●";
    let hlBox: HTMLElement | null = null;
    for (const { ch, hl } of pieces) {
      if (ch === "\n") {
        out.append(document.createElement("br"));
        hlBox = null;
      } else if (hl) {
        if (!hlBox) {
          hlBox = document.createElement("em");
          hlBox.className = "hl";
          out.append(hlBox);
        }
        hlBox.append(ch);
      } else {
        hlBox = null;
        out.append(ch);
      }
      await wait(ch === "\n" ? 260 : jitter(28, 30));
    }
  };

  // 마무리 줄: 질문을 보낸 뒤 답변이 끝날 때까지 걸린 시간과 지금 시각(보는 사람 기기 기준)
  const finish = (started: number) => {
    const sec = Math.max(1, Math.round((performance.now() - started) / 1000));
    const took = sec >= 60 ? `${Math.floor(sec / 60)}m ${sec % 60}s` : `${sec}s`;
    const at = new Date().toLocaleTimeString("en-US", { hour: "numeric", minute: "2-digit" });
    done!.innerHTML = `<span class="done-sign">✻</span><span>${pick(DONE_VERBS)} for ${took} · done ${at}</span>`;
  };

  const round = async (question: string, pieces: Piece[]) => {
    await typeAsk(question);
    const started = performance.now();
    await think(started);
    await typeAnswer(pieces);
    finish(started);
  };

  if (ask && answer && lead && done && !reduce) {
    const rounds = [{ question: ask.textContent!.trim(), pieces: toPieces(answer) }];
    if (next) rounds.push({ question: next.dataset.ask ?? "", pieces: toPieces(next.content) });

    // 워드마크 등장 애니메이션이 끝날 때까지 질문 줄은 커서만, 답변 자리는 비워 둠
    ask.replaceChildren(makeCursor());
    answer.replaceChildren();
    lead.textContent = "";

    (async () => {
      await wait(900);
      await round(rounds[0].question, rounds[0].pieces);
      if (rounds.length < 2) return;
      for (let i = 1; ; i = (i + 1) % rounds.length) {
        await wait(10000);
        answer.replaceChildren();
        lead.textContent = "";
        done.replaceChildren();
        await eraseAsk();
        await round(rounds[i].question, rounds[i].pieces);
      }
    })();
  }
</script>

<style>
  .intro {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: var(--s-6);
    align-items: end;
    padding-block: var(--s-8) var(--s-6);
  }
  .tagline { margin: 0 0 var(--s-3); color: var(--muted); font-size: var(--t-md); }
  .wordmark {
    font-family: var(--font-display);
    font-size: var(--t-3xl);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.03em;
    line-height: 0.92;
    margin: 0;
  }
  .line { display: block; }
  .ch {
    display: inline-block;
    opacity: 0;
    animation: rise 0.5s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
    animation-delay: calc(var(--i) * 70ms + 150ms);
  }
  .caret {
    display: inline-block;
    width: 0.1em;
    height: 0.78em;
    margin-left: 0.06em;
    /* --accent는 흰 배경에서 대비가 낮아 라이트 모드에선 진한 같은 색조를 씀(다크에선 두 값이 같음) */
    background: var(--accent-text);
    opacity: 0;
    animation: blink 1s steps(1) 0.8s infinite;
  }
  @keyframes rise {
    from { opacity: 0; transform: translateY(0.35em); filter: blur(4px); }
    to { opacity: 1; transform: none; filter: none; }
  }
  @keyframes blink {
    0% { opacity: 1; }
    50% { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ch { opacity: 1; animation: none; }
    .caret { opacity: 1; animation: none; }
  }
  /* 소개는 질문에 AI가 답하는 터미널처럼 보이게. 라이트 모드는 Claude Code 라이트 테마, 다크 모드는 다크 테마 색 */
  .term {
    --term-bg: #fafafa;
    --term-fg: #2b2c31;
    --term-bar: #efeff1;
    --term-bar-line: #e4e4e7;
    --term-rule: #d4d4d8;
    --term-ask: #3b3c40;
    --term-strong: #151515;
    --term-spin: #d77757;
    --term-status: #6c6e75;
    --term-dim: #8a8c93;
    /* Claude Code 라이트 테마의 인라인 코드 색(rgb 87 105 247) */
    --term-hl: #5769f7;
    /* grid 아이템 기본 min-width:auto면 nowrap인 생각 중 줄 길이만큼 창이 늘었다 줄었다 함 */
    min-width: 0;
    padding: var(--s-4) var(--term-px);
    background: var(--term-bg);
    color: var(--term-fg);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font-size: var(--t-sm);
    line-height: 1.75;
  }
  /* 시스템 다크와 토글 다크 두 곳에 같은 값을 둠. --term-hl은 Claude Code 다크 테마의 인라인 코드 색(rgb 177 185 249) */
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .term {
      --term-bg: #111214;
      --term-fg: #e6e6e9;
      --term-bar: #1c1d21;
      --term-bar-line: #2a2b30;
      --term-rule: #3a3b41;
      --term-ask: #c9cacf;
      --term-strong: #ffffff;
      --term-spin: #ff8a5c;
      --term-status: #8d9099;
      --term-dim: #6c6e75;
      --term-hl: #b1b9f9;
    }
  }
  :global(:root[data-theme="dark"]) .term {
    --term-bg: #111214;
    --term-fg: #e6e6e9;
    --term-bar: #1c1d21;
    --term-bar-line: #2a2b30;
    --term-rule: #3a3b41;
    --term-ask: #c9cacf;
    --term-strong: #ffffff;
    --term-spin: #ff8a5c;
    --term-status: #8d9099;
    --term-dim: #6c6e75;
    --term-hl: #b1b9f9;
  }
  .term p { margin: 0; }
  /* macOS 창 타이틀바: 창 안쪽 여백을 넘어 창 폭 전체에 깔고, 가운데 제목을 둠 */
  .titlebar {
    position: relative;
    display: flex;
    align-items: center;
    height: 28px;
    margin: calc(var(--s-4) * -1) calc(var(--term-px) * -1) var(--s-4);
    padding-inline: 12px;
    border-bottom: 1px solid var(--term-bar-line);
    background: var(--term-bar);
    border-radius: var(--radius) var(--radius) 0 0;
  }
  .lights { display: flex; gap: 8px; }
  .lights i { width: 12px; height: 12px; border-radius: 50%; background: #ff5f57; }
  .lights i:nth-child(2) { background: #febc2e; }
  .lights i:nth-child(3) { background: #28c840; }
  .title {
    position: absolute;
    inset-inline: 0;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--term-dim);
    pointer-events: none;
  }
  /* 질문 줄은 Claude Code 입력창처럼 위아래 가로선 사이에 둠 */
  /* ❯ 기호, 생각 중 기호, 답변 동그라미가 같은 왼쪽 열(--lead-w)에 놓임 */
  .term { --lead-w: 1.5em; --term-px: var(--s-5); }
  .prompt {
    display: flex;
    align-items: center;
    margin-bottom: var(--s-3) !important;
    padding-block: var(--s-1);
    border-block: 1px solid var(--term-rule);
    color: var(--term-ask);
  }
  /* 기호와 한글은 글꼴이 달라 기준선이 어긋나므로 줄 높이를 없애고 flex 가운데 정렬에 맡김 */
  .sign { flex: 0 0 var(--lead-w); font-family: var(--font-mono); line-height: 1; color: var(--term-strong); }
  .reply { display: flex; }
  .lead { flex: 0 0 var(--lead-w); font-family: var(--font-mono); color: var(--term-strong); }
  .lead.spinning { color: var(--term-spin); }
  .answer { flex: 1; min-width: 0; min-height: calc(1.75em * 3); }
  /* 마무리 줄 자리는 미리 잡아 두어 마지막에 줄이 생길 때 아래 카드가 밀리지 않게 함 */
  .done { display: flex; min-height: 1.75em; margin-top: var(--s-2) !important; color: var(--term-dim); font-size: var(--t-xs); }
  .done :global(.done-sign) { flex: 0 0 var(--lead-w); font-family: var(--font-mono); }
  .answer :global(.status) { display: block; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; color: var(--term-status); }
  .answer :global(.meta) { font-family: var(--font-mono); font-size: var(--t-xs); color: var(--term-dim); }
  .answer :global(.hl) { font-style: normal; color: var(--term-hl); }
  /* 질문 줄 커서는 스크립트가 만들어 범위 스타일이 안 붙으므로 전역 선택자로 지정. 답변에는 커서를 두지 않음 */
  .term :global(.cursor) {
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    margin-left: 2px;
    vertical-align: -0.2em;
    background: currentColor;
    animation: blink 1s steps(1) infinite;
  }

  /* 진입점 카드 4개: 데스크톱은 한 줄, 좁은 화면은 2열. 모두 정사각형이고 간격 없이 붙임 */
  .doors {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-bottom: var(--s-9);
  }
  /* 배경이 테마와 상관없이 고정색이라 글자색도 테마 토큰 대신 카드마다 정한 --card-ink를 씀 */
  .door {
    aspect-ratio: 1 / 1;
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    padding: var(--s-5);
    background: var(--card);
    color: var(--card-ink);
    transition: background 0.15s;
  }
  .door:hover { background: color-mix(in srgb, var(--card) 85%, #000); }
  /* 오프화이트 카드는 라이트 모드의 흰 페이지와 경계가 흐려 안쪽 선을 둠 */
  .door.outlined { box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--card) 88%, #000); }
  .door.outlined:hover { background: color-mix(in srgb, var(--card) 94%, #000); }
  .door-label { font-size: var(--t-xl); font-weight: 700; letter-spacing: -0.03em; }
  .door-caption { font-size: var(--t-sm); color: color-mix(in srgb, var(--card-ink) 85%, transparent); line-height: 1.5; }
  .door-foot { margin-top: auto; display: flex; justify-content: space-between; align-items: baseline; }
  .n { font-size: var(--t-sm); }
  .arrow { transition: transform 0.15s; }
  .door:hover .arrow { transform: translateX(4px); }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* 카드 제목은 호버하면 섹션 이름에 맞춰 글자마다 움직임. 글자가 inline-block이라 밑줄은 쓰지 않음 */
  .lch { display: inline-block; }
  .door:is(:hover, :focus-visible) [data-motion="entries"] .lch {
    transform-origin: 50% 100%;
    animation: tumble 0.5s steps(1, end) infinite;
  }
  .door:is(:hover, :focus-visible) [data-motion="notes"] .lch {
