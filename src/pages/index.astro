---
import Base from "@/layouts/Base.astro";
import { SECTIONS, url } from "@/lib/site";
import EntryList from "@/components/EntryList.astro";
import PostList from "@/components/PostList.astro";
import { countBy, getEntries, STATUS_META } from "@/lib/entries";
import { getPosts } from "@/lib/posts";
import { ENTRY_STATUSES } from "@/content.config";

const entries = await getEntries();
const posts = await getPosts();
const notes = await getPosts("notes");
const counts = countBy(entries, (e) => e.data.status);
const recent = entries.slice(0, 8);
// 글자마다 순번(--i)을 매겨 차례로 등장시킴
const wordmark = ["CDD", "LABS"].map((line, li, all) => {
  const offset = all.slice(0, li).join("").length;
  return [...line].map((ch, i) => ({ ch, i: offset + i }));
});
const doors = [
  { ...SECTIONS.entries, count: entries.length },
  { ...SECTIONS.notes, count: notes.length },
  { ...SECTIONS.posts, count: posts.length },
];
---

<Base>
  <section class="container intro">
    <div class="lead">
      <p class="tagline">디디의 아이디어 보관소</p>
      <h1 class="wordmark" aria-label="CDD LABS">
        {wordmark.map((line, li) => (
          <span class="line" aria-hidden="true">
            {line.map(({ ch, i }) => <span class="ch" style={`--i:${i}`}>{ch}</span>)}
            {li === wordmark.length - 1 && <span class="caret"></span>}
          </span>
        ))}
      </h1>
    </div>
    <div class="about">
      <p>
        제 머릿속에 있는 여러 가지 아이디어들을<br />
        기획하고, 스케치하는 스케치북 같은 공간입니다.<br />
        요즘 같은 시대에 쇠맛 안 나게 잘 가꿔보겠습니다.
      </p>
    </div>
  </section>

  <nav class="container doors" aria-label="진입점">
    {doors.map((d) => (
      <a href={url(d.href)} class="door">
        <span class="door-label">{d.label}<span class="mono n">{d.count}</span></span>
        <span class="door-caption">{d.caption}</span>
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    ))}
  </nav>

  <section class="container recent">
    <div class="recent-head">
      <h2 class="recent-title">{SECTIONS.entries.label}</h2>
      <a href={url(SECTIONS.entries.href)} class="mono text-link">전체 보기 ({entries.length})</a>
    </div>
    <ol class="pipeline" aria-label="단계별 문서 수">
      {ENTRY_STATUSES.map((s) => (
        <li class:list={{ empty: !counts[s] }}>
          <a href={url(`/entries?status=${s}`)}>
            <span class="name">{STATUS_META[s].label}</span>
            <span class="n">{counts[s] ?? 0}</span>
          </a>
        </li>
      ))}
    </ol>
    <EntryList entries={recent} />
  </section>

  <section class="container recent">
    <div class="recent-head">
      <h2 class="recent-title">{SECTIONS.notes.label}</h2>
      <a href={url(SECTIONS.notes.href)} class="mono text-link">전체 보기 ({notes.length})</a>
    </div>
    <PostList posts={notes.slice(0, 5)} />
  </section>

  <section class="container recent">
    <div class="recent-head">
      <h2 class="recent-title">{SECTIONS.posts.label}</h2>
      <a href={url(SECTIONS.posts.href)} class="mono text-link">전체 보기 ({posts.length})</a>
    </div>
    <PostList posts={posts.slice(0, 5)} />
  </section>
</Base>

<style>
  .intro {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: var(--s-6);
    align-items: end;
    padding-block: var(--s-8) var(--s-6);
  }
  .tagline { margin: 0 0 var(--s-3); color: var(--muted); font-size: var(--t-md); }
  .wordmark {
    font-family: var(--font-display);
    font-size: var(--t-3xl);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.03em;
    line-height: 0.92;
    margin: 0;
  }
  .line { display: block; }
  .ch {
    display: inline-block;
    opacity: 0;
    animation: rise 0.5s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
    animation-delay: calc(var(--i) * 70ms + 150ms);
  }
  .caret {
    display: inline-block;
    width: 0.1em;
    height: 0.78em;
    margin-left: 0.06em;
    background: var(--accent);
    opacity: 0;
    animation: blink 1s steps(1) 0.8s infinite;
  }
  @keyframes rise {
    from { opacity: 0; transform: translateY(0.35em); filter: blur(4px); }
    to { opacity: 1; transform: none; filter: none; }
  }
  @keyframes blink {
    0% { opacity: 1; }
    50% { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ch { opacity: 1; animation: none; }
    .caret { opacity: 1; animation: none; }
  }
  .about p { margin: 0 0 var(--s-4); color: var(--ink-2); line-height: 1.75; }

  /* 진입점: 뚝딱뚝딱 | 차곡차곡 | 끄적끄적 */
  .doors { display: grid; grid-template-columns: repeat(3, 1fr); }
  .door {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    padding: var(--s-5) var(--s-6) var(--s-5) 0;
    border-top: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line);
  }
  .door + .door { padding-left: var(--s-5); border-left: 1px solid var(--line); }
  .door-label { display: flex; align-items: baseline; gap: var(--s-2); font-size: var(--t-xl); font-weight: 700; letter-spacing: -0.03em; }
  .door-caption { font-size: var(--t-xs); color: var(--muted); }
  .arrow { position: absolute; right: var(--s-4); top: var(--s-5); color: var(--faint); transition: transform 0.15s; }
  .door:hover .arrow { color: var(--ink); transform: translateX(4px); }
  .door:hover .door-label { text-decoration: underline; text-underline-offset: 5px; text-decoration-thickness: 1px; }

  /* 단계 브레드크럼: 아이디어 › 진행중 › 완성 */
  .pipeline {
    list-style: none;
    margin: 0;
    padding: var(--s-4) 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    row-gap: var(--s-2);
    border-block: 1px solid var(--line);
  }
  .pipeline li { display: inline-flex; align-items: center; }
  .pipeline li + li::before {
    content: "";
    width: 8px;
    height: 8px;
    border-top: 1px solid var(--faint);
    border-right: 1px solid var(--faint);
    transform: rotate(45deg);
    margin: 0 var(--s-5) 0 var(--s-4);
  }
  .pipeline a { display: inline-flex; align-items: baseline; gap: var(--s-2); }
  .name { font-size: var(--t-lg); font-weight: 700; letter-spacing: -0.02em; }
  .n { font-family: var(--font-mono); font-size: var(--t-sm); color: var(--muted); }
  .empty .name, .empty .n { color: var(--faint); }
  .pipeline a:hover .name { text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; }

  .recent { margin-top: var(--s-8); }
  .recent .pipeline { border-top: 0; }
  .recent-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--s-3);
  }
  .recent-title { font-size: var(--t-lg); font-weight: 700; letter-spacing: -0.02em; margin: 0; }

  @media (max-width: 720px) {
    .intro { grid-template-columns: 1fr; gap: var(--s-5); padding-block: var(--s-7) var(--s-5); }
    .wordmark { font-size: 44px; }
    .name { font-size: var(--t-md); }
    .pipeline li + li::before { margin: 0 var(--s-3) 0 var(--s-2); }
    .doors { grid-template-columns: 1fr; }
    .door + .door { padding-left: 0; border-left: 0; border-top-color: var(--line); }
  }
</style>
