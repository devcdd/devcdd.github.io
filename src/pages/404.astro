---
import Base from "@/layouts/Base.astro";
---

<Base title="페이지 없음">
  <div class="container wrap">
    <p class="label">404</p>
    <h1 class="title">페이지를 찾을 수 없습니다.</h1>
    <a href="/" class="text-link">← 처음으로</a>
  </div>
</Base>

<style>
  .wrap { padding-top: var(--s-9); }
  .title { font-size: var(--t-2xl); font-weight: 700; letter-spacing: -0.03em; margin: var(--s-2) 0 var(--s-5); }
</style>
